# Prototipo: sin datos reales, sin PHI, sin biometria.
# Todas las integraciones estan simuladas en lib/datos/ y lib/dominio/.

# Modo de datos: "mock" (unico soportado hoy) | "api" (futuro gateway)
NEXT_PUBLIC_DATA_MODE=mock

# Sede activa por defecto del piloto propuesto (RF-28: configurable por sede)
NEXT_PUBLIC_SITE_ID=HRLAM-ISSSTE

# Banner permanente de entorno no clinico (RNF-07)
NEXT_PUBLIC_ENV_LABEL=PROTOTIPO - DATOS SINTETICOS


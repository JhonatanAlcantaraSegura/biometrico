{
  "name": "ers-biometria-codigo-infarto",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo de identificacion de paciente y orquestacion del Codigo Infarto (ERS v1.1)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "contraste": "node --experimental-strip-types scripts/contraste.mts",
    "probar:motor": "node --experimental-strip-types --import ./scripts/alias.mjs scripts/probar-motor.mts",
    "verificar": "npm run contraste && npm run probar:motor && npm run typecheck"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
